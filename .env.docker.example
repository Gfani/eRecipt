# ==============================================================================
# eReceipt - Docker Environment Variables Template
# Copy this file to .env.docker or .env to configure container settings
# ==============================================================================

# PostgreSQL Database Configuration
POSTGRES_DB=ereceipt
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# Backend API Configuration
BACKEND_PORT=5000
NODE_ENV=production
CORS_ORIGIN=*

# Email Notifications (Optional - Resend API)
RESEND_API_KEY=
RESEND_FROM_EMAIL=eReceipt Tax Portal <onboarding@resend.dev>

# Frontend Configuration
FRONTEND_PORT=80
VITE_API_BASE_URL=http://localhost:5000
